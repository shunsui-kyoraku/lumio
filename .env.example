# ---------------------------------------------------------------------------
# SkillTree environment variables
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (e.g. Neon, Supabase, Vercel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/skilltree?sslmode=require"

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk webhook signing secret (Dashboard -> Webhooks -> your endpoint)
# Used by /api/webhooks/clerk to verify Svix signatures.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Clerk component routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Anthropic (AI assistant). Server-side only — never expose with NEXT_PUBLIC_.
ANTHROPIC_API_KEY="sk-ant-..."

# Clerk Billing plan id for the Premium checkout button (Dashboard -> Billing -> Plans)
NEXT_PUBLIC_CLERK_PREMIUM_PLAN_ID="cplan_..."
